(executables
 (names instrumentation scenario_fuzz)
 (modules instrumentation scenario_fuzz)
 (libraries harness crowbar)
 (modes exe))

(library
 (name fuzz_input)
 (modules fuzz_input)
 (libraries crowbar unix))

(test
 (name fuzz_input_test)
 (modules fuzz_input_test)
 (libraries fuzz_input unix))

(executable
 (name core_fuzz)
 (modules core_fuzz)
 (libraries httpkit-core crowbar fuzz_input)
 (modes exe))

(executable
 (name http1_fuzz)
 (modules http1_fuzz)
 (libraries http1_conformance httpkit-core httpkit-http1 crowbar fuzz_input)
 (modes exe))

(executable (name engine_fuzz) (modules engine_fuzz) (libraries engine_scenarios crowbar fuzz_input) (modes exe))

(executable (name release_fuzz) (modules release_fuzz) (libraries httpkit-core httpkit-engine crowbar fuzz_input) (modes exe))

(executable (name adapter_fuzz) (modules adapter_fuzz) (libraries httpkit-core httpkit-engine httpkit-transport-eio httpkit-transport-lwt eio.mock lwt.unix crowbar fuzz_input) (modes exe))

; Deterministic OCaml PR smoke; no AFL process or instrumentation is required.
(rule
 (alias runtest)
 (action
  (progn
   (setenv HTTP_KIT_FUZZ_CASE request (run ./http1_fuzz.exe -r 200 -s 42))
   (setenv HTTP_KIT_FUZZ_CASE response (run ./http1_fuzz.exe -r 200 -s 42))
   (setenv HTTP_KIT_FUZZ_CASE chunked (run ./http1_fuzz.exe -r 200 -s 42)))))

(executable
 (name web_fuzz)
 (modules web_fuzz)
 (libraries http1_conformance httpkit-core httpkit httpkit-router crowbar fuzz_input)
 (modes exe))

(rule
 (alias runtest)
 (action
  (progn
   (setenv HTTP_KIT_FUZZ_CASE url (run ./web_fuzz.exe -r 200 -s 42))
   (setenv HTTP_KIT_FUZZ_CASE forms (run ./web_fuzz.exe -r 200 -s 42))
   (setenv HTTP_KIT_FUZZ_CASE router (run ./web_fuzz.exe -r 200 -s 42))
   (setenv HTTP_KIT_FUZZ_CASE multipart (run ./web_fuzz.exe -r 200 -s 42))
   (setenv HTTP_KIT_FUZZ_CASE websocket (run ./web_fuzz.exe -r 200 -s 42)))))
