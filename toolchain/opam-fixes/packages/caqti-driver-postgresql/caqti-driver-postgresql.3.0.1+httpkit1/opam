synopsis: "Caqti PostgreSQL driver with httpkit cancellation cleanup fix"
description: """
Local httpkit patch of upstream 3.0.1, not an upstream release. Clear the
connection busy flag even when exception cleanup is cancelled or fails.
The upstream source archive and license remain unchanged; the patch is applied
before building. All ordinary query/protocol behavior comes from Caqti.
"""
depends: [
  "alcotest" {with-test & >= "1.5.0"}
  "ocaml"
  "caqti" {>= "3.0.0" & < "3.1.0~"}
  "cmdliner" {with-test & >= "1.1.0"}
  "dune" {>= "3.23.1"}
  "odoc" {with-doc}
  "postgresql" {>= "5.0.0"}
  "uri" {>= "4.0.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
  ["dune" "build" "@doc" "-p" name "-j" jobs] {with-doc}
]
patches: ["httpkit-cancellation.patch"]
extra-files: [
