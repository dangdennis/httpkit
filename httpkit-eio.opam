# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Composable Eio web application server"
maintainer: ["httpkit maintainers"]
authors: ["httpkit maintainers"]
depends: [
  "dune" {>= "3.24"}
  "httpkit"
  "httpkit-router"
  "httpkit-middleware"
  "httpkit-transport-eio"
  "eio"
  "base64"
  "yojson"
  "mtime"
  "cstruct"
  "ocaml" {= "5.5.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
