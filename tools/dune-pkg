#!/bin/sh
# Bootstrap boundary: Dune must be runnable before the OCaml developer CLI exists.
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$task_root"
HARNESS_COMPILER=${HARNESS_COMPILER:-5.5.0}
[ "$HARNESS_COMPILER" = 5.5.0 ] || { echo 'HARNESS_COMPILER must be 5.5.0' >&2; exit 2; }
export HARNESS_COMPILER
unset DUNE_WORKSPACE DUNE_BUILD_DIR OCAMLPATH OCAMLLIB CAML_LD_LIBRARY_PATH DUNE_CONFIG__PKG DUNE_CONFIG__PORTABLE_LOCK_DIR DUNE_CONFIG__RELOCATABLE_COMPILER
export PATH="$task_root/.toolchain/bin:$PATH"
export XDG_CACHE_HOME="$task_root/.toolchain/cache"
task_dune="$task_root/.toolchain/bin/dune"
[ -x "$task_dune" ] || { echo 'Run tools/bootstrap to install Dune' >&2; exit 2; }
task_expected=$(sed -n 's/^[[:space:]]*"dune": "\([^"]*\)".*/\1/p' toolchain/manifest.json)
[ "$("$task_dune" --version)" = "$task_expected" ] || { echo "Expected Dune $task_expected" >&2; exit 2; }
[ "$#" -gt 0 ] || exec "$task_dune"
task_custom_build=false
for task_arg in "$@"; do
  case "$task_arg" in --build-dir|--build-dir=*) task_custom_build=true ;; esac
done
if [ "$1" = pkg ] && [ "${2:-}" = lock ]; then
  [ "$#" -ne 2 ] || set -- "$@" dune.lock
else
  [ -f dune.lock/lock.dune ] || { echo 'Missing dune.lock/lock.dune' >&2; exit 2; }
fi
task_cmd=$1; shift
if [ "$task_cmd" = pkg ]; then task_sub=$1; shift; set -- "$task_sub" "--workspace=$task_root/dune-workspace" "$@"
else set -- "--workspace=$task_root/dune-workspace" "$@"; fi
if [ "$task_custom_build" = false ]; then
  if [ "$task_cmd" = pkg ]; then task_sub=$1; shift; set -- "$task_sub" "--build-dir=_build-pkg-$HARNESS_COMPILER" "$@"
  else set -- "--build-dir=_build-pkg-$HARNESS_COMPILER" "$@"; fi
fi
exec "$task_dune" "$task_cmd" "$@"
